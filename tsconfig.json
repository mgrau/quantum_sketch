{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": false,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "misty-states": ["../misty_states/src/core/api.ts"],
      "misty-states/render": ["../misty_states/src/core/index.ts"],
      "misty-states/kernel": ["../misty_states/src/core/kernel.ts"],
      "misty-states/ui": ["../misty_states/src/core/ui/board.ts"],
      "misty-states/metadata": ["../misty_states/src/core/metadata.ts"],
      "misty-states/encode": ["../misty_states/src/core/render/encode.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
